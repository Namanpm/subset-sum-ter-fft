# subset-sum-ter-fft: ignore only what is generated, transient, local-tool state,
# or not ours to publish. Everything else (sources, specs, paper sources, frozen
# evidence, result records) is visible to git by default.
# The previous allow-list version is kept locally at .attic/gitignore.before-20261012.

# --- Build output (rebuild with the commands in AGENTS.md) ---
/build/
/build-*/
/out/
Testing/
CMakeUserPresets.json
*.obj
*.o
*.exe
*.pdb
*.ilk
*.exp
*.lib
*.dll
*.a
*.so
*.dylib

# --- Authentic root snapshots: 0.1-1.0 GB each, regenerated deterministically from
#     their seed; SHA-256 values are recorded in results/ and paper/data/. The
#     small <name>.snap.json metadata files stay visible. ---
*.snap

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- Local tool and agent state ---
/.claude/worktrees/
/.claude/settings.local.json
/.gstack/
/.cmem-projects/
/.superpowers/
/graphify-out/
.cache/
# Local holding area for cleanup leftovers (scratch notes, old ledgers); never committed.
/.attic/

# --- Transient ---
/bench.lock
*.tmp
*.swp
*.bak
*~
Thumbs.db
desktop.ini
.DS_Store

# --- Paper: render/QA output, scratch, and the generated release bundle ---
# Default paper validation requires local qa/ inputs; fresh clones use --portable.
# The protected-file hash inventory is the one qa/ file kept in git.
/paper/qa/*
!/paper/qa/continuation-20261009/
/paper/qa/continuation-20261009/*
!/paper/qa/continuation-20261009/protected_files_before.json
/paper/working/
/paper/*.zip

# --- Third-party literature, old drafts and a copy of the DOCX (not ours to publish) ---
/Research papers/
