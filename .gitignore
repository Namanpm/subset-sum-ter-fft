!CMakeLists.txt

# Third-party license provenance stays versioned despite the *.txt rule above:
# src/root_partition_block_inplace.cpp cites this file as the BSD-2-Clause text
# covering its IPS2Ra-derived source, so the citation must resolve in-tree.
!third_party/licenses/*.txt

# TER root-partition measurement data. Per-repetition rows are bulk (~40 MB) and
# regenerable; every raw file's SHA-256 is recorded in the versioned
# data-hashes.jsonl, so local copies stay verifiable without committing them.
# The Task-11 decision audit trail below is versioned deliberately: the captured
# root rows plus bench/analyse_root_partition.py reproduce analysis/*.json exactly.
/results/**/*.jsonl
!/results/partition/task11-final-20260825/command-manifest.jsonl
!/results/partition/task11-final-20260825/data-hashes.jsonl
!/results/partition/task11-final-20260825/captured-root/*.jsonl
!/results/partition/task11-final-20260825/rerun-N32496-reverse-t2-b2048/*.jsonl
.gstack/

# Data and diagnostic output: CSV, JSON/JSONL and captured stderr.
# Already-tracked files stay tracked; this only stops new ones from being added.
*.csv
*.json
*.jsonl
*.stderr
# The Task-11 partition decision audit trail stays versioned (see above).
!/results/partition/task11-final-20260825/**/*.json
!/results/partition/task11-final-20260825/command-manifest.jsonl
!/results/partition/task11-final-20260825/data-hashes.jsonl
!/results/partition/task11-final-20260825/captured-root/*.jsonl
!/results/partition/task11-final-20260825/rerun-N32496-reverse-t2-b2048/*.jsonl
# Generated Visual Studio projects and captured root snapshots (~1 GB each).
*.vcxproj
*.snap
# ARWLF regime campaign figure data (main paper results) stays versioned.
!/results/arwlf/regime-20261001/speedup_vs_L.csv
!/results/arwlf/regime-20261001/regret_vs_L.csv

