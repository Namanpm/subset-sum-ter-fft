# Generated, disposable input: never exercise truncation regressions on a real snapshot.
if(NOT DEFINED TEST_EXE OR NOT DEFINED TEST_SCRATCH)
    message(FATAL_ERROR "TEST_EXE and TEST_SCRATCH are required")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
set(scratch "${TEST_SCRATCH}/${suffix}")
file(MAKE_DIRECTORY "${scratch}")
set(input "${scratch}/input.snap")
file(WRITE "${input}" "HASH_JOIN_INPUT_PRESERVATION_FIXTURE\n")
file(SHA256 "${input}" before)

function(check_alias output)
    execute_process(COMMAND "${TEST_EXE}" "--snapshot=${input}" "--out=${output}"
                            --microproblems=1 --validate-only
                    RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(NOT result EQUAL 2 OR NOT stderr MATCHES "OutputInvalid")
        message(FATAL_ERROR "Expected early output-alias refusal; result=${result}: ${stdout}${stderr}")
    endif()
    file(SHA256 "${input}" after)
    if(NOT before STREQUAL after)
        message(FATAL_ERROR "Input fixture changed on output refusal")
    endif()
endfunction()

check_alias("${input}")
check_alias("${scratch}/./input.snap")
if(WIN32)
    string(TOUPPER "${input}" upper)
    check_alias("${upper}")
endif()
file(CREATE_LINK "${input}" "${scratch}/hard-link.snap" RESULT link_result)
if(NOT link_result STREQUAL "0")
    message(FATAL_ERROR "Cannot construct hard-link safety fixture: ${link_result}")
endif()
check_alias("${scratch}/hard-link.snap")
message(STATUS "Hash-join CLI input/output alias guards passed; input SHA256 unchanged")
